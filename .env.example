# Copy to .env and edit. Everything here has a working default, so an empty
# file is also valid: the system then uses the values shown below.

# --- robot ---------------------------------------------------------------
# Huayan E05-L1345_Pro controller. Leave alone unless the network changes.
HEACON_ROBOT_HOST=192.168.0.10
HEACON_ROBOT_PORT=10003

# --- network -------------------------------------------------------------
# 0.0.0.0 means "listen on every interface", which the tablet needs.
HEACON_HTTP_HOST=0.0.0.0
HEACON_HTTP_PORT=8765
HEACON_HTTPS_HOST=0.0.0.0
HEACON_HTTPS_PORT=8766

# --- directories ---------------------------------------------------------
# Writable scratch space, logs, camera frames, TLS material.
# HEACON_RUNTIME_DIR=/var/lib/heacon
# Calibration and taught poses (handeye.json, color_calib.json, work_home.json).
# HEACON_CONFIG_DIR=/etc/heacon
# Page bundle served on 8765.
# HEACON_WEB_DIR=/opt/heacon/web
# HEACON_LOG_DIR=/var/log/heacon

# --- behaviour -----------------------------------------------------------
# 1 = fake arm, no TCP to the robot, synthetic camera frame. For development,
# CI and demos. MUST be 0 on a machine that drives a real arm.
HEACON_SIMULATE=0

# auto | macos | linux | none
HEACON_CAMERA_BACKEND=auto
