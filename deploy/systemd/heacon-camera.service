[Unit]
Description=HEACON 摄像头采集 (RealSense D435i)
Documentation=file:/opt/heacon/docs/部署.md
After=network-online.target

[Service]
Type=simple
User=heacon
Group=heacon
# The camera device appears after boot; the daemon waits for it on its own,
# so no ordering dependency on the USB subsystem is needed.
SupplementaryGroups=video
WorkingDirectory=/opt/heacon
EnvironmentFile=-/etc/heacon/heacon.env
Environment=HEACON_RUNTIME_DIR=/var/lib/heacon
Environment=HEACON_CONFIG_DIR=/etc/heacon
Environment=HEACON_LOG_DIR=/var/log/heacon
ExecStart=/opt/heacon/.venv/bin/python /opt/heacon/main.py camera
Restart=always
RestartSec=5

# A RealSense open can take several seconds on a cold boot; do not kill it.
TimeoutStopSec=15

StandardOutput=append:/var/log/heacon/camera.log
StandardError=append:/var/log/heacon/camera.log

# Unlike the console, this one must reach /dev/bus/usb directly.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/heacon /var/log/heacon
DeviceAllow=/dev/bus/usb rw

[Install]
WantedBy=multi-user.target
