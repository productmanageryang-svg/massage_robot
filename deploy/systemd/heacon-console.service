[Unit]
Description=HEACON 按摩艾灸机器人 控制台 (8765)
Documentation=file:/opt/heacon/docs/部署.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=heacon
Group=heacon
WorkingDirectory=/opt/heacon
EnvironmentFile=-/etc/heacon/heacon.env
Environment=HEACON_RUNTIME_DIR=/var/lib/heacon
Environment=HEACON_CONFIG_DIR=/etc/heacon
Environment=HEACON_LOG_DIR=/var/log/heacon
Environment=HEACON_WEB_DIR=/opt/heacon/web
ExecStart=/opt/heacon/.venv/bin/python /opt/heacon/main.py console
Restart=always
RestartSec=3

# The arm is real here. Turning on the simulator in production would make the
# console report a fake pose while the hardware stands still.
Environment=HEACON_SIMULATE=0

# Give the controller time to close its socket on shutdown instead of leaving
# a half-open session that faults on the next connect.
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=append:/var/log/heacon/console.log
StandardError=append:/var/log/heacon/console.log

# Modest hardening. The service only needs its own tree and the network.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/heacon /var/log/heacon
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
